\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerfontthemeHUAS}[2026/09/26 HUAS Beamer font hierarchy]

\mode<presentation>
% 自主调字号优先在导言区 \setbeamerfont{角色}{size=...}，见 docs/customization.md。
% AutoFakeBold=2 只控制 SimHei 的模拟加粗程度，增大后标题笔画更厚。
% Body uses the ctex Song family; headings use its Hei family on each platform.
% SimHei has no native bold face, so only that family uses a modest fake bold.
\IfFontExistsTF{SimHei}{%
  \newCJKfontfamily\huas@heiti[AutoFakeBold=2]{SimHei}%
}{\newcommand{\huas@heiti}{\heiti}}
\renewcommand{\familydefault}{\rmdefault}
\setbeamerfont{normal text}{family=\rmfamily}
\setbeamerfont{title}{family={\sffamily\huas@heiti},size=\LARGE,series=\bfseries}
\setbeamerfont{subtitle}{family=\rmfamily,size=\normalsize,series=\mdseries}
\setbeamerfont{HUAS school name}{family={\sffamily\huas@heiti},size=\normalsize,series=\bfseries}
\setbeamerfont{HUAS english name}{size=\scriptsize}
\setbeamerfont{HUAS title meta}{size=\small}
\setbeamerfont{section title}{family={\sffamily\huas@heiti},size=\LARGE,series=\bfseries}
\setbeamerfont{HUAS section label}{size=\small}
\setbeamerfont{HUAS motto}{size=\scriptsize}
\setbeamerfont{HUAS closing title}{family={\sffamily\huas@heiti},size=\LARGE,series=\bfseries}
\setbeamerfont{frametitle}{family={\sffamily\huas@heiti},size=\large,series=\bfseries}
\setbeamerfont{footline}{family={\sffamily\huas@heiti},size=\scriptsize}
\setbeamerfont{block title}{family={\sffamily\huas@heiti},size=\normalsize,series=\bfseries}
\setbeamerfont{block body}{family=\rmfamily,size=\normalsize}
\setbeamerfont{quote}{size=\normalsize,shape=\upshape}
\setbeamerfont{quotation}{size=\normalsize,shape=\upshape}
\setbeamerfont{HUAS source}{size=\scriptsize}
\setbeamerfont{HUAS key point}{family={\sffamily\huas@heiti},size=\LARGE,series=\bfseries}
\setbeamerfont{caption}{size=\small}
\setbeamerfont{caption name}{series=\bfseries}
\setbeamerfont{bibliography entry author}{size=\small}
\setbeamerfont{bibliography entry title}{size=\small}
\setbeamerfont{bibliography entry location}{size=\scriptsize}
\setbeamerfont{bibliography entry note}{size=\scriptsize}
\mode<all>

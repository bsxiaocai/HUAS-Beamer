\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerfontthemeHUAS}[2026/09/26 HUAS Beamer font hierarchy]

\mode<presentation>
% ctexbeamer supplies portable Chinese font selection for XeLaTeX.
\setbeamerfont{title}{size=\LARGE,series=\bfseries}
\setbeamerfont{subtitle}{size=\normalsize}
\setbeamerfont{HUAS school name}{size=\normalsize,series=\bfseries}
\setbeamerfont{HUAS english name}{size=\scriptsize}
\setbeamerfont{HUAS title meta}{size=\small}
\setbeamerfont{section title}{size=\LARGE,series=\bfseries}
\setbeamerfont{HUAS section label}{size=\small}
\setbeamerfont{HUAS motto}{size=\scriptsize}
\setbeamerfont{HUAS closing title}{size=\LARGE,series=\bfseries}
\setbeamerfont{frametitle}{size=\large,series=\bfseries}
\setbeamerfont{footline}{size=\scriptsize}
\mode<all>

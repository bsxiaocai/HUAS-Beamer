\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamercolorthemeHUAS}[2026/09/26 HUAS derived colors]

\mode<presentation>
% HUAS-Beamer Derived Design System: provisional, not official VI values.
\definecolor{HUASRed}{HTML}{A34A42}
\definecolor{HUASTerracotta}{HTML}{B76F4F}
\definecolor{HUASInk}{HTML}{292929}
\definecolor{HUASMuted}{HTML}{666666}
\definecolor{HUASPaper}{HTML}{FFFFFF}
\definecolor{HUASWarmPaper}{HTML}{F8F4EF}
\definecolor{HUASLine}{HTML}{E5DDD8}
% Sampled from the supplied teaching PDF; these are project-derived colors.
\definecolor{HUASBlue}{HTML}{3333B2}
\definecolor{HUASNavy}{HTML}{191959}
\definecolor{HUASCoolPaper}{HTML}{E9E9F3}

\setbeamercolor{background canvas}{bg=HUASPaper}
\setbeamercolor{normal text}{fg=HUASInk,bg=HUASPaper}
\setbeamercolor{structure}{fg=HUASRed}
\setbeamercolor{title}{fg=HUASRed}
\setbeamercolor{frametitle}{fg=HUASRed,bg=HUASPaper}
\setbeamercolor{footline}{fg=HUASMuted,bg=HUASPaper}
\setbeamercolor{alerted text}{fg=HUASRed}
% Hero colors are independent of the light academic content canvas.
\newcommand{\huas@academiccolors}{%
  \setbeamercolor{HUAS title canvas}{bg=HUASPaper}%
  \setbeamercolor{HUAS divider canvas}{bg=HUASWarmPaper}%
  \setbeamercolor{HUAS hero}{fg=HUASInk}%
  \setbeamercolor{HUAS hero title}{fg=HUASRed}%
  \setbeamercolor{HUAS hero muted}{fg=HUASMuted}%
  \setbeamercolor{HUAS hero rule}{fg=HUASRed}%
  \setbeamercolor{HUAS hero footer}{fg=HUASMuted,bg=HUASWarmPaper}%
}
\newcommand{\huas@warmcolors}{%
  \setbeamercolor{HUAS title canvas}{bg=HUASRed}%
  \setbeamercolor{HUAS divider canvas}{bg=HUASRed}%
  \setbeamercolor{HUAS hero}{fg=HUASPaper}%
  \setbeamercolor{HUAS hero title}{fg=HUASPaper}%
  \setbeamercolor{HUAS hero muted}{fg=HUASPaper}%
  \setbeamercolor{HUAS hero rule}{fg=HUASPaper}%
  \setbeamercolor{HUAS hero footer}{fg=HUASMuted,bg=HUASPaper}%
}
\newcommand{\huas@coolcolors}{%
  \setbeamercolor{HUAS title canvas}{bg=HUASPaper}%
  \setbeamercolor{HUAS divider canvas}{bg=HUASCoolPaper}%
  \setbeamercolor{HUAS hero}{fg=HUASNavy}%
  \setbeamercolor{HUAS hero title}{fg=HUASBlue}%
  \setbeamercolor{HUAS hero muted}{fg=HUASMuted}%
  \setbeamercolor{HUAS hero rule}{fg=HUASBlue}%
  \setbeamercolor{HUAS hero footer}{fg=HUASMuted,bg=HUASCoolPaper}%
}
\newcommand{\huas@contentcolors}{%
  \ifhuas@cool
    \colorlet{HUASAccent}{HUASBlue}%
    \setbeamercolor{frametitle}{fg=HUASPaper,bg=HUASBlue}%
    \setbeamercolor{footline}{fg=HUASPaper,bg=HUASNavy}%
    \huas@coolcolors
  \else
    \colorlet{HUASAccent}{HUASRed}%
    \setbeamercolor{frametitle}{fg=HUASRed,bg=HUASPaper}%
    \setbeamercolor{footline}{fg=HUASMuted,bg=HUASPaper}%
    \huas@academiccolors
  \fi
  \setbeamercolor{structure}{fg=HUASAccent}%
  \setbeamercolor{title}{fg=HUASAccent}%
  \setbeamercolor{HUAS context}{fg=HUASPaper,bg=HUASNavy}%
  \setbeamercolor{block title}{fg=HUASPaper,bg=HUASAccent}%
  \setbeamercolor{block body}{fg=HUASInk,bg=HUASAccent!8}%
  \setbeamercolor{block title alerted}{fg=HUASPaper,bg=HUASRed!90!black}%
  \setbeamercolor{block body alerted}{fg=HUASInk,bg=HUASRed!6}%
  \setbeamercolor{block title example}{fg=HUASInk,bg=HUASAccent!18}%
  \setbeamercolor{block body example}{fg=HUASInk,bg=HUASAccent!4}%
  \setbeamercolor{HUAS quotation}{fg=HUASInk,bg=HUASAccent!6}%
  \setbeamercolor{HUAS source}{fg=HUASMuted}%
  \setbeamercolor{caption}{fg=HUASInk}%
  \setbeamercolor{caption name}{fg=HUASAccent}%
  \setbeamercolor{bibliography entry author}{fg=HUASInk}%
  \setbeamercolor{bibliography entry title}{fg=HUASInk}%
  \setbeamercolor{bibliography entry location}{fg=HUASMuted}%
  \setbeamercolor{bibliography entry note}{fg=HUASMuted}%
}
\huas@contentcolors
\mode<all>

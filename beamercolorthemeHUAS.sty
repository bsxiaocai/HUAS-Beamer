\setbeamercolor{title}{fg=HUASRed}
\setbeamercolor{frametitle}{fg=HUASRed,bg=HUASPaper}
\setbeamercolor{footline}{fg=HUASMuted,bg=HUASPaper}
\setbeamercolor{alerted text}{fg=HUASRed}
\mode<all>

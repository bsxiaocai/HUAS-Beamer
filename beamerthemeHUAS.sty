\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeHUAS}[2026/09/26 Phase 1 HUAS Beamer theme]

\newif\ifhuas@footer
\huas@footertrue
\newif\ifhuas@logo
\huas@logofalse
\DeclareOptionBeamer{footer}{\huas@footertrue}
\DeclareOptionBeamer{nofooter}{\huas@footerfalse}
\DeclareOptionBeamer{logo}{\huas@logotrue}
\DeclareOptionBeamer{nologo}{\huas@logofalse}
\ProcessOptionsBeamer

\mode<presentation>
\usecolortheme{HUAS}
\usefonttheme{HUAS}
\useinnertheme{HUAS}
\input{theme/huas-assets.tex}
\useoutertheme{HUAS}
\setbeamertemplate{navigation symbols}{}
\mode<all>

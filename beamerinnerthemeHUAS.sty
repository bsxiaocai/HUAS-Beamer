\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerinnerthemeHUAS}[2026/09/26 HUAS Beamer inner theme]

\mode<presentation>
\setbeamertemplate{itemize items}[circle]
\newcommand{\huas@herofooter}[1]{%
  % 总宽度为正文宽；两栏均在框内按局部 linewidth 求值，hfill 分配剩余间距。
  \begin{beamercolorbox}[wd=\textwidth,sep=\huas@layout{hero padding}]{HUAS hero footer}
    \begin{minipage}[b]{\huas@layout{hero column width}}
      \usebeamercolor[fg]{HUAS hero footer}#1
    \end{minipage}\hfill
    \begin{minipage}[b]{\huas@layout{hero column width}}
      \raggedleft\huas@insertbuilding
    \end{minipage}
  \end{beamercolorbox}%
}
\setbeamertemplate{title page}{%
  \ifhuas@cool
    \usebeamertemplate{HUAS cool title page}%
  \else
  % vfill 是弹性留白：实际标题位置还受标题换行和辅助区高度影响。
  \vspace*{\huas@layout{title top}}%
  \noindent
  \ifhuas@logo
    \ifhuas@warm\else
    \ifx\huas@logofile\@empty\else
      % -0.12cm 为校徽与校名的基线校正；0.8em 为二者水平间距。
      \raisebox{-0.12cm}{\huas@insertlogo[\huas@layout{logo title height}]}\hspace{0.8em}%
    \fi
    \fi
  \fi
  \begin{minipage}{\huas@layout{identity width}}
    {\usebeamerfont{HUAS school name}\usebeamercolor[fg]{HUAS hero}\huas@schoolname\par}
    {\usebeamerfont{HUAS english name}\usebeamercolor[fg]{HUAS hero muted}\huas@schoolsecondary\par}
  \end{minipage}\par
  \vfill
  {\usebeamerfont{title}\usebeamercolor[fg]{HUAS hero title}\inserttitle\par}
  \ifx\insertsubtitle\@empty\else
    \vspace{\huas@layout{subtitle gap}}%
    {\usebeamerfont{subtitle}\usebeamercolor[fg]{HUAS hero muted}\insertsubtitle\par}%
  \fi
  \vspace{\huas@layout{title rule gap}}%
  {\usebeamercolor[fg]{HUAS hero rule}\rule{\huas@layout{hero rule width}}{\huas@layout{hero rule thickness}}\par}%
  \vfill
  \huas@herofooter{\usebeamerfont{HUAS title meta}%
    % The red transparent badge stays legible on Warm's light metadata panel.
    \ifhuas@warm\ifhuas@logo
      \ifx\huas@logofile\@empty\else
        % Warm 信息区校徽的基线下移 0.15cm，作者前间距为 0.4em。
        \raisebox{-0.15cm}{\huas@insertlogo[\huas@layout{logo panel height}]}\hspace{0.4em}%
      \fi
    \fi\fi
    \insertauthor\par
    \insertinstitute\par\insertdate\par}%
  \vspace*{\huas@layout{hero bottom}}%
  \fi
}
\setbeamertemplate{HUAS cool title page}{%
  \vspace*{\huas@layout{title top}}%
  {\usebeamerfont{HUAS school name}\usebeamercolor[fg]{HUAS hero}\huas@schoolname\par}%
  {\usebeamerfont{HUAS english name}\usebeamercolor[fg]{HUAS hero muted}\huas@schoolsecondary\par}%
  \vfill
  \begin{beamercolorbox}[wd=\textwidth,sep=\huas@layout{cool title padding},center]{frametitle}
    {\usebeamerfont{title}\inserttitle\par}%
    \ifx\insertsubtitle\@empty\else
      \vspace{\huas@layout{cool subtitle gap}}{\usebeamerfont{subtitle}\insertsubtitle\par}%
    \fi
  \end{beamercolorbox}%
  \vfill
  {\centering\usebeamerfont{HUAS title meta}\insertauthor\par
    \insertinstitute\par\insertdate\par}%
  \vfill
  \huas@herofooter{\usebeamerfont{HUAS motto}\huas@motto\par
    \ifhuas@logo\huas@insertlogo[\huas@layout{logo panel height}]\fi}%
  \vspace*{\huas@layout{hero bottom}}%
}
\setbeamertemplate{section page}{%
  \vspace*{\huas@layout{divider top}}%
  {\usebeamerfont{HUAS section label}\usebeamercolor[fg]{HUAS hero muted}\huas@schoolname\par}%
  \vfill
  {\usebeamercolor[fg]{HUAS hero rule}\rule{\huas@layout{section rule width}}{\huas@layout{hero rule thickness}}\par}%
  \vspace{\huas@layout{section rule gap}}%
  {\usebeamerfont{section title}\usebeamercolor[fg]{HUAS hero}\insertsection\par}%
  \vfill
  \huas@herofooter{\usebeamerfont{HUAS motto}\huas@motto\par
    \ifx\huas@faculty\@empty\else\huas@faculty\par\fi}%
  \vspace*{\huas@layout{hero bottom}}%
}
\setbeamertemplate{HUAS closing page}{%
  \vspace*{\huas@layout{divider top}}%
  {\usebeamerfont{HUAS section label}\usebeamercolor[fg]{HUAS hero muted}\huas@schoolname\par}%
  \vfill
  {\usebeamerfont{HUAS closing title}\usebeamercolor[fg]{HUAS hero title}%
    \ifhuas@english Thank you\else 谢谢聆听\fi\par}%
  \vspace{\huas@layout{closing subtitle gap}}%
  \ifhuas@english\else
    {\usebeamerfont{subtitle}\usebeamercolor[fg]{HUAS hero muted}Thank you\par}%
  \fi
  \vspace{\huas@layout{closing rule gap}}%
  {\usebeamercolor[fg]{HUAS hero rule}\rule{\huas@layout{hero rule width}}{\huas@layout{hero rule thickness}}\par}%
  \vfill
  \huas@herofooter{\usebeamerfont{HUAS motto}\huas@motto\par
    \ifx\huas@faculty\@empty\else\huas@faculty\par\fi}%
  \vspace*{\huas@layout{hero bottom}}%
}
\newcommand{\HUASclosingpage}{\usebeamertemplate{HUAS closing page}}
% Scope hero colors to a complete frame, restoring the content canvas afterwards.
\newcommand{\huas@heroframe}[2]{%
  \begingroup
  \ifhuas@cool\huas@coolcolors\else
    \ifhuas@warm\huas@warmcolors\else\huas@academiccolors\fi
  \fi
  \setbeamercolor{background canvas}{use=#1,bg=#1.bg}%
  \begin{frame}[plain,noframenumbering]
    #2
  \end{frame}
  \endgroup
}
\newcommand{\HUASmaketitle}{\huas@heroframe{HUAS title canvas}{\titlepage}}
\newcommand{\HUASsectionframe}{\huas@heroframe{HUAS divider canvas}{\sectionpage}}
\newcommand{\HUASclosingframe}{\huas@heroframe{HUAS divider canvas}{\HUASclosingpage}}
\AtBeginSection[]{%
  \ifhuas@sectionpage
    \ifbeamer@inframe\else\HUASsectionframe\fi
  \fi
}
\mode<all>
